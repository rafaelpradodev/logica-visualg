algoritmo "Simulador_CDB"

var
  valor: real
  prazo: inteiro
  taxa: real

inicio

  escreva("Digite o valor do investimento: ")
  leia(valor)

  escreva("Digite o prazo em meses: ")
  leia(prazo)

  se (prazo > 12) entao
    taxa <- 0.12
  senao
    taxa <- 0.08
  fimse

  escreval("Taxa aplicada: ", taxa * 100, "% ao ano")

fimalgoritmo